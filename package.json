{
  "name": "ee-knowledge-starter",
  "version": "0.3.0-alpha.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db": "prisma migrate deploy",
    "db:setup": "prisma migrate deploy && npm run db:seed",
    "db:seed": "tsx prisma/seed.ts",
    "db:check": "tsx scripts/check-db-integrity.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:restore": "tsx scripts/restore-db.ts",
    "verify:demo": "tsx scripts/verify-demo-data.ts",
    "verify:content": "tsx scripts/verify-content-transfer.ts",
    "verify:admin-query": "tsx scripts/verify-admin-query.ts",
    "verify:structure": "tsx scripts/verify-structure.ts",
    "verify:review": "tsx scripts/verify-review.ts",
    "verify:practice": "tsx scripts/verify-practice.ts",
    "verify:statistics": "tsx scripts/verify-statistics.ts",
    "verify:mvp": "tsx scripts/verify-mvp.ts",
    "release:check": "tsx scripts/release-check.ts",
    "verify:pwa": "tsx scripts/verify-pwa.ts"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "katex": "^0.18.9",
    "next": "^15.5.27",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "prisma": "6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
